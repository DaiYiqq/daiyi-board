<UserControl
    x:Class="LiquidGlassDock.Controls.GlassDock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:LiquidGlassDock.Controls">

    <Grid
        x:Name="LayoutRoot"
        Background="Transparent"
        PointerPressed="OnSlidePressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnSlideReleased"
        PointerCanceled="OnSlideReleased"
        PointerExited="OnPointerExited">

        <!-- 底栏玻璃：胶囊形态（圆角=半高），由着色器或内置效果管线渲染 -->
        <canvas:CanvasControl
            x:Name="GlassSurface"
            IsHitTestVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- 按钮行：每个工具都是一个独立的液态玻璃胶囊按钮 -->
        <StackPanel
            x:Name="ButtonRow"
            Orientation="Horizontal"
            Spacing="4"
            Padding="10,7"
            Background="Transparent">

            <controls:LiquidGlassPillButton x:Name="BtnSelect" Tag="Select" Glyph="&#xE7A8;" Text="选择" Width="54" Height="54" />
            <controls:LiquidGlassPillButton x:Name="BtnPen"    Tag="Pen"    Glyph="&#xE70F;" Text="画笔" Width="54" Height="54" />
            <controls:LiquidGlassPillButton x:Name="BtnEraser" Tag="Eraser" Glyph="&#xE75C;" Text="橡皮" Width="54" Height="54" />
            <controls:LiquidGlassPillButton x:Name="BtnNote"   Tag="Note"   Glyph="&#xE70B;" Text="便签" Width="54" Height="54" />
            <controls:LiquidGlassPillButton x:Name="BtnShape"  Tag="Shape"  Glyph="&#xE91C;" Text="形状" Width="54" Height="54" />
            <controls:LiquidGlassPillButton x:Name="BtnText"   Tag="Text"   Glyph="&#xE8D2;" Text="文字" Width="54" Height="54" />

        </StackPanel>
    </Grid>
</UserControl>
