<Window
    x:Class="LiquidGlassDock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LiquidGlassDock.Controls">

    <Grid x:Name="Root" Background="#0B0D10">

        <!-- 白板（含墨迹/便签/形状，支持平移缩放书写） -->
        <controls:WhiteboardView x:Name="Board" />

        <!-- 底部透明液态玻璃按钮栏 -->
        <controls:GlassDock
            x:Name="Dock"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24" />

        <!-- 参数面板开关（右上角） -->
        <Button
            x:Name="SettingsToggle"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,14,14,0"
            Padding="12,8"
            Background="#33FFFFFF"
            Foreground="#E6EAF0"
            BorderThickness="0"
            CornerRadius="10"
            Click="OnToggleSettings">
            <FontIcon Glyph="&#xE713;" FontSize="16" />
        </Button>

        <!-- 液态玻璃参数面板 -->
        <controls:SettingsPanel
            x:Name="Settings"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,56,14,0"
            Visibility="Collapsed" />

    </Grid>
</Window>
