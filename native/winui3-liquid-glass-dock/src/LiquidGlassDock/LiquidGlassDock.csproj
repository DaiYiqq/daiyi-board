<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DY Board 液态玻璃底部按钮栏 Demo —— WinUI 3 / Windows App SDK + Win2D
    非打包（unpackaged）运行方式，最简单：dotnet run 或 VS 直接 F5。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>LiquidGlassDock</RootNamespace>
    <AssemblyName>LiquidGlassDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 非打包：不生成 MSIX，直接跑 exe -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 编译好的液态玻璃像素着色器，作为嵌入资源在运行时加载 -->
    <EmbeddedResource Include="Shaders\LiquidGlassPill.cso" />
    <!-- HLSL 源码：仅作参考/编辑，不参与 .NET 编译 -->
    <None Include="Shaders\LiquidGlassPill.hlsl" />
  </ItemGroup>

</Project>
